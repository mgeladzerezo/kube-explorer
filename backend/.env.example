DATABASE_URL=postgresql+psycopg://kube_explorer:kube_explorer@localhost:5432/kube_explorer

# kubeconfig | in-cluster | fixture (serves ../faults/*/captured, no cluster needed)
KUBE_MODE=fixture
KUBE_FIXTURE_DIR=../faults

# anthropic | fake (keyword baseline, no API key needed)
LLM_MODE=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_REFUSAL_FALLBACK=true
